<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameHub - O'yinlar Makoni</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #0f172a;
            color: #ffffff;
            padding-bottom: 70px;
        }
        header {
            background: #1e293b;
            padding: 15px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            color: #38bdf8;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .banner {
            background: linear-gradient(45deg, #f59e0b, #ef4444);
            margin: 15px;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            font-weight: bold;
            font-size: 18px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
        }
        .container {
            padding: 15px;
        }
        .section-title {
            font-size: 18px;
            margin-bottom: 10px;
            color: #94a3b8;
        }
        .game-card {
            background: #1e293b;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .game-info h3 {
            font-size: 16px;
            margin-bottom: 4px;
        }
        .game-info p {
            font-size: 12px;
            color: #94a3b8;
        }
        .download-btn {
            background: #22c55e;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }
        /* Modal oyna (Reklama va Tayмер) */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            width: 85%;
            max-width: 320px;
        }
        .modal-content h3 {
            margin-bottom: 15px;
            font-size: 18px;
        }
        .timer {
            font-size: 24px;
            font-weight: bold;
            color: #f59e0b;
            margin: 15px 0;
        }
        /* Pastki menyu */
        nav {
            position: fixed;
            bottom: 0; left: 0;
            width: 100%;
            background: #1e293b;
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            border-top: 1px solid #334155;
        }
        nav a {
            color: #94a3b8;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
        }
        nav a.active {
            color: #38bdf8;
        }
    </style>
</head>
<body>

    <header>🎮 GameHub</header>

    <div class="banner">
        🔥 Eng zo'r o'yinlar va ilovalar shu yerda!
    </div>

    <div class="container">
        <div class="section-title">O'yinlar ro'yxati</div>

        <!-- 1-o'yin -->
        <div class="game-card">
            <div class="game-info">
                <h3>Cyber Adventure</h3>
                <p>Action • 45 MB</p>
            </div>
            <button class="download-btn" onclick="startDownload('https://admitad.com_sizning_oson_linkigiz')">Скачать</button>
        </div>

        <!-- 2-o'yin -->
        <div class="game-card">
            <div class="game-info">
                <h3>Speed Racing 3D</h3>
                <p>Poyga • 60 MB</p>
            </div>
            <button class="download-btn" onclick="startDownload('https://admitad.com_sizning_oson_linkigiz')">Скачать</button>
        </div>
    </div>

    <!-- Reklama va Taymer oynasi -->
    <div id="adModal" class="modal">
        <div class="modal-content">
            <h3>Reklama yuklanmoqda...</h3>
            <p>Iltimos biroz kuting, yuklab olish tez orada boshlanadi.</p>
            <div class="timer" id="countdown">7</div>
        </div>
    </div>

    <!-- Pastki menyu -->
    <nav>
        <a href="#" class="active">🏠 Asosiy</a>
        <a href="#">🔥 Market</a>
        <a href="#">⚡ Shorts</a>
        <a href="#">👤 Panel</a>
    </nav>

    <script>
        let redirectUrl = "";

        function startDownload(url) {
            redirectUrl = url;
            let modal = document.getElementById("adModal");
            let counter = document.getElementById("countdown");
            let timeLeft = 7;
            
            modal.style.display = "flex";
            counter.innerText = timeLeft;

            let downloadTimer = setInterval(function() {
                timeLeft--;
                counter.innerText = timeLeft;
                if (timeLeft <= 0) {
                    clearInterval(downloadTimer);
                    modal.style.display = "none";
                    window.location.href = redirectUrl; // Admitad yoki yuklab olish havolasiga o'tadi
                }
            }, 1000);
        }
    </script>
</body>
</html>
